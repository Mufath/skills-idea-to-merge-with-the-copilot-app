<section class="bookmark-manager" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Paste a URL with or without <code>https://</code> to generate its short <code>mona-</code> slug.</p>
  <p id="status" class="status" role="status" aria-live="polite"></p>
  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import { createSlug, formatBookmark, loadBookmarks, normalizeUrl } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.querySelector('#add-bookmark');
  const urlInput = document.querySelector('#url');
  const list = document.querySelector('#bookmark-list');
  const emptyState = document.querySelector('#empty-state');
  const listHeader = document.querySelector('#list-header');
  const clearAll = document.querySelector('#clear-all');
  const status = document.querySelector('#status');

  function readBookmarks() {
    try {
      return loadBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      return [];
    }
  }

  let bookmarks = readBookmarks();

  function showStatus(message) {
    status.textContent = message;
  }

  function render() {
    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copy.dataset.slug = bookmark.slug;

      item.append(link, separator, slug, copy);
      list.append(item);
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();

    try {
      const url = normalizeUrl(urlInput.value);
      let slug = createSlug();
      while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
        slug = createSlug();
      }

      const bookmark = { url, slug };
      const updatedBookmarks = [...bookmarks, bookmark];
      window.localStorage.setItem(storageKey, JSON.stringify(updatedBookmarks));
      bookmarks = updatedBookmarks;
      render();
      form.reset();
      showStatus(`Saved ${formatBookmark(bookmark)}.`);
    } catch (error) {
      showStatus(error instanceof Error ? error.message : 'Unable to save this bookmark.');
    }
  });

  list.addEventListener('click', async (event) => {
    const button = event.target.closest('button.copy');
    if (!button) return;

    try {
      await navigator.clipboard.writeText(button.dataset.slug);
      showStatus(`Copied ${button.dataset.slug}.`);
    } catch {
      showStatus('Could not access the clipboard. Select and copy the slug instead.');
    }
  });

  clearAll.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;

    try {
      window.localStorage.removeItem(storageKey);
      bookmarks = [];
      render();
      showStatus('All bookmarks cleared.');
    } catch {
      showStatus('Unable to clear bookmarks from this browser.');
    }
  });

  render();
</script>
